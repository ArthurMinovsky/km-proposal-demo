# MCP / Vault Cortex (Auth token is optional for local demo)
MCP_AUTH_TOKEN=
MCP_PORT=9705
PUBLIC_URL=http://localhost:9705
VAULT_CORTEX_TAG=latest
VAULT_HOST_PATH=./runtime/vault
MCP_DATA_PATH=./runtime/mcp-data
EMBEDDING_ENABLED=false
RERANK_MODE=none
MEMORY_ENABLED=false
FILE_TOOLS_ENABLED=true
PROTECTED_PATHS=
TZ=Asia/Bangkok
LOG_LEVEL=info

# Optional Obsidian Sync server profile.
# Use a disposable remote vault for this demo.
OBSIDIAN_AUTH_TOKEN=
VAULT_NAME=
VAULT_PASSWORD=
OBSIDIAN_SERVER_TAG=latest
OBSIDIAN_CONFIG_PATH=./runtime/obsidian-config
DEVICE_NAME=km-proposal-demo
CONFLICT_STRATEGY=merge
SYNC_MODE=bidirectional
SYNC_CONFIGS=
SYNC_EXCLUDED_FOLDERS=
SYNC_FILE_TYPES=
PUID=1000
PGID=1000
